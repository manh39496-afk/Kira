---
import type { Character } from '../data/characters';

interface Props {
  character: Character;
}

const { character } = Astro.props as Props;
---

<a href={`/characters#${character.id}`} class="character-card" style={`--card-accent: ${character.accent}`}>
  <div class="character-card-visual">
    {character.portrait ? (
      <img src={character.portrait} alt={character.portraitAlt ?? ''} loading="lazy" />
    ) : (
      <span class="empty-visual">Hình ảnh đang được hoàn thiện</span>
    )}
  </div>
  <div class="character-card-body">
    <span class="character-card-faction">{character.faction}</span>
    <h3>{character.name}</h3>
    <span class="character-card-role">{character.title}</span>
  </div>
</a>

<style>
  .character-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .character-card-visual {
    aspect-ratio: 3 / 4;
    border-bottom: 3px solid var(--card-accent);
  }

  .character-card-visual img,
  .character-card-visual .empty-visual {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .character-card-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 16px 20px 20px;
  }

  .character-card-faction,
  .character-card-role {
    font-family: var(--font-sans);
    font-size: 0.72rem;
  }

  .character-card-faction {
    color: var(--card-accent);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .character-card h3 {
    font-size: 1.1rem;
  }

  .character-card-role {
    color: var(--color-ink-muted);
  }
</style>
