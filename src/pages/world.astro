---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { regions, lore } from '../data/world';
---

<Layout title="Thế giới" description="Khám phá thế giới của Aetherbound: thủ đô sụp đổ, các thành bang tự do, vùng biên cương và những truyền thuyết của cõi giới tan vỡ.">
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow fade-in">Cõi giới tan vỡ</span>
      <h1 class="page-title fade-in fade-in-delay-1">Thế giới</h1>
      <div class="divider fade-in fade-in-delay-2"></div>
      <p class="page-lead fade-in fade-in-delay-2">
        Một lục địa tan vỡ được níu giữ bởi nền hòa bình mong manh. Khám phá các vùng đất, phe phái và lịch sử bị chôn vùi dẫn dắt biên niên sử.
      </p>
    </div>
  </section>

  <!-- Regions -->
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Địa lý" title="Các vùng đất" subtitle="Từ miệng vực Old Aethel đến những thánh đường kết tinh muối của Giáo hội, mỗi vùng đất đều giữ một phần sự thật và một lý do để che giấu nó." />
      <div class="region-list">
        {regions.map((r, i) => (
          <article class:list={['region-card', `region-${i % 2 === 0 ? 'left' : 'right'}`]} id={r.id}>
            <div class="region-image">
              {r.image ? (
                <img src={r.image} alt={r.imageAlt ?? ''} loading="lazy" />
              ) : (
                <span class="empty-visual">Hình ảnh đang được hoàn thiện</span>
              )}
            </div>
            <div class="region-content">
              <span class="region-type">{r.type}</span>
              <h2 class="region-name">{r.name}</h2>
              <p class="region-summary">{r.summary}</p>
              <p class="region-detail">{r.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Lore -->
  <section class="section section-alt">
    <div class="container">
      <SectionHeader eyebrow="Những truyền thuyết sâu xa" title="Nền móng của sự sụp đổ" subtitle="Lịch sử, phép thuật và những liên minh bất ổn định hình từng chương của biên niên sử." />
      <div class="lore-grid">
        {lore.map((entry) => (
          <article class="lore-card">
            <div class="lore-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M4 4h12a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4V4z" />
                <path d="M4 4v12a4 4 0 0 0 4 4" />
                <path d="M8 8h8M8 12h8M8 16h5" />
              </svg>
            </div>
            <h3 class="lore-title">{entry.title}</h3>
            <p class="lore-body">{entry.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section">
    <div class="container container-narrow">
      <SectionHeader eyebrow="Dòng thời gian" title="Lịch sử đang được hoàn thiện" subtitle="Các cột mốc thế giới được duyệt sẽ được bổ sung khi trình tự thời gian được xác lập." align="center" />
      <div class="timeline-empty empty-visual">
        <p>Dòng thời gian của thế giới đang được hoàn thiện.</p>
      </div>
    </div>
  </section>

  <!-- Factions summary -->
  <section class="section">
    <div class="container container-narrow">
      <SectionHeader eyebrow="Các thế lực" title="Tổng quan các phe phái" align="center" />
      <div class="faction-list">
        <div class="faction-item">
          <h3>Church of Aethel</h3>
          <p>Một tổ chức thần quyền dạy rằng sự sụp đổ là phán xét. Giáo hội kiểm soát Saltwatch và phái các Collector thu hồi hoặc hủy diệt mọi thứ chạm vào dấu ấn.</p>
        </div>
        <div class="faction-item">
          <h3>Veranthor Accord</h3>
          <p>Một liên minh mong manh của học giả, quý tộc và Free Companies đặt căn cứ tại thành bang ven biển. Đây là thứ gần với một chính quyền nhất, và cũng gần với một âm mưu nhất, mà cõi giới có được.</p>
        </div>
        <div class="faction-item">
          <h3>Free Companies</h3>
          <p>Những người lính giải ngũ hiện đồn trú tại Iron Marches. Họ thề phục vụ cả đời, được trả bằng những mảnh đất sẽ không bao giờ canh tác, và là những người duy nhất từng thấy thứ bước ra khỏi Hollow.</p>
        </div>
        <div class="faction-item">
          <h3>Hollow Crown</h3>
          <p>Không phải một phe phái mà là một thế lực, bất kể thứ gì đang ngủ bên dưới miệng vực Old Aethel. Nó không có quân đội cũng không có tiếng nói người sống nghe được. Dấu ấn đáp lại nó.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 80px 0 48px;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .page-title {
    font-family: 'Cormorant Garamond', var(--font-serif);
    font-size: 3rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .page-lead {
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    max-width: 600px;
  }

  /* Regions */
  .region-list {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .region-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .region-card.right {
    direction: rtl;
  }

  .region-card.right > * {
    direction: ltr;
  }

  .region-image {
    aspect-ratio: 3/2;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border-soft);
    box-shadow: var(--shadow-md);
  }

  .region-image img,
  .region-image .empty-visual {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .region-type {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 8px;
    display: block;
  }

  .region-name {
    font-family: 'Cormorant Garamond', var(--font-serif);
    font-size: 2rem;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .region-summary {
    font-size: 1.1rem;
    color: var(--color-ink);
    font-style: italic;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .region-detail {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  /* Lore */
  .lore-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .lore-card {
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .lore-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .lore-icon {
    color: var(--color-gold);
    margin-bottom: 16px;
  }

  .lore-title {
    font-family: 'Cormorant Garamond', var(--font-serif);
    font-size: 1.3rem;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .lore-body {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  /* Factions */
  .faction-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .timeline-empty {
    min-height: 180px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
  }

  .faction-item {
    text-align: left;
    padding: 24px;
    background: var(--color-surface);
    border-left: 3px solid var(--color-gold);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .faction-item h3 {
    font-family: 'Cormorant Garamond', var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .faction-item p {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .lore-grid { grid-template-columns: 1fr; }
    .faction-list { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .page-title { font-size: 2.2rem; }
    .region-card,
    .region-card.right {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 24px;
    }
    .region-name { font-size: 1.6rem; }
  }
</style>
