---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const extras = [
  {
    label: 'KIRA STORY',
    title: 'KIRA STORY',
    text: 'A tertiary story space for approved KIRA STORY material.',
  },
  {
    label: 'Truyện bên lề',
    title: 'Truyện bên lề',
    text: 'Các tư liệu truyện bổ sung có thể được thêm vào đây khi sẵn sàng để chia sẻ.',
  },
  {
    label: 'Thử nghiệm',
    title: 'Nội dung thử nghiệm',
    text: 'Không gian riêng cho các thử nghiệm và tư liệu ngoài nội dung chính đã được duyệt để công bố.',
  },
];
---

<Layout title="Nội dung thêm" description="Truyện bên lề, KIRA STORY và tư liệu thử nghiệm của dự án.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow fade-in">Kho phụ</span>
      <h1 class="page-title fade-in fade-in-delay-1">Nội dung thêm</h1>
      <div class="divider fade-in fade-in-delay-2"></div>
      <p class="page-lead fade-in fade-in-delay-2">
        Kho lưu trữ bổ sung cho truyện bên lề, KIRA STORY và tư liệu thử nghiệm.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Tư liệu bổ sung" title="Ngoài kho chính" subtitle="Các bộ sưu tập này được giữ riêng với nội dung chính về thế giới, truyện, nhân vật và hình ảnh." />
      <div class="extras-grid">
        {extras.map((extra) => (
          <article class="extras-card">
            <span class="eyebrow">{extra.label}</span>
            <h2>{extra.title}</h2>
            <p>{extra.text}</p>
            <div class="extras-empty empty-visual">Nội dung đang được hoàn thiện</div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 80px 0 48px;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .page-title {
    font-family: 'Cormorant Garamond', var(--font-serif);
    font-size: 3rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .page-lead {
    max-width: 600px;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }

  .extras-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .extras-card {
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
  }

  .extras-card h2 {
    margin-bottom: 12px;
    font-size: 1.5rem;
  }

  .extras-card p {
    min-height: 72px;
    font-size: 0.92rem;
  }

  .extras-empty {
    min-height: 120px;
    margin-top: 24px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 800px) {
    .extras-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
