---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const extras = [
  {
    label: 'KIRA STORY',
    title: 'KIRA STORY',
    text: 'A tertiary story space for approved KIRA STORY material.',
  },
  {
    label: 'Side Stories',
    title: 'Side Stories',
    text: 'Additional story material can be added here when it is ready to share.',
  },
  {
    label: 'Experimental',
    title: 'Experimental Content',
    text: 'A separate space for experiments and non-core material approved for publication.',
  },
];
---

<Layout title="Extras" description="Side stories, KIRA STORY, and experimental material for the SRPG project.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow fade-in">Secondary Archive</span>
      <h1 class="page-title fade-in fade-in-delay-1">Extras</h1>
      <div class="divider fade-in fade-in-delay-2"></div>
      <p class="page-lead fade-in fade-in-delay-2">
        A lower-priority archive for side stories, KIRA STORY, and experimental material.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Additional Material" title="Beyond the Core Archive" subtitle="These collections remain separate from the primary world, story, character, and art navigation." />
      <div class="extras-grid">
        {extras.map((extra) => (
          <article class="extras-card">
            <span class="eyebrow">{extra.label}</span>
            <h2>{extra.title}</h2>
            <p>{extra.text}</p>
            <div class="extras-empty empty-visual">Content pending</div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 80px 0 48px;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .page-title {
    font-family: 'Cormorant Garamond', var(--font-serif);
    font-size: 3rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .page-lead {
    max-width: 600px;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }

  .extras-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .extras-card {
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
  }

  .extras-card h2 {
    margin-bottom: 12px;
    font-size: 1.5rem;
  }

  .extras-card p {
    min-height: 72px;
    font-size: 0.92rem;
  }

  .extras-empty {
    min-height: 120px;
    margin-top: 24px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 800px) {
    .extras-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
