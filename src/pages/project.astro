---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const projectSections = [
  {
    eyebrow: 'Ghi chú phát triển',
    title: 'Ghi chú sẽ được tập hợp tại đây',
    text: 'Nơi tập trung các cập nhật, quyết định và ghi chú tiến độ của dự án trong quá trình phát triển.',
  },
  {
    eyebrow: 'Quy trình',
    title: 'Không gian xây dựng dự án',
    text: 'Quy trình thực hiện dự án sẽ được ghi lại tại đây mà không công khai cơ chế nội bộ hay nội dung canon chưa được duyệt.',
  },
  {
    eyebrow: 'Cột mốc',
    title: 'Các cột mốc đang được hoàn thiện',
    text: 'Các cột mốc được duyệt sẽ được bổ sung khi lộ trình phát triển sẵn sàng để chia sẻ.',
  },
  {
    eyebrow: 'Hậu trường',
    title: 'Tư liệu phát triển đang chờ bổ sung',
    text: 'Tư liệu hậu trường được chọn có thể được thêm vào đây khi được duyệt để công bố.',
  },
];
---

<Layout title="Dự án" description="Ghi chú phát triển, quy trình, cột mốc và tiến độ của dự án.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow fade-in">Dự án</span>
      <h1 class="page-title fade-in fade-in-delay-1">Tiến độ dự án</h1>
      <div class="divider fade-in fade-in-delay-2"></div>
      <p class="page-lead fade-in fade-in-delay-2">
        Theo dõi quá trình phát triển thế giới giả tưởng, câu chuyện, nhân vật, hình ảnh và các phần liên quan đến game.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="project-grid">
        {projectSections.map((section) => (
          <article class="project-card">
            <span class="eyebrow">{section.eyebrow}</span>
            <h2>{section.title}</h2>
            <p>{section.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container container-narrow">
      <SectionHeader eyebrow="Tiến độ hiện tại" title="Dự án đang thành hình" subtitle="Tổng quan tiến độ sẽ được mở rộng cùng các cập nhật phát triển được duyệt." align="center" />
      <div class="progress-empty empty-visual">
        <p>Chi tiết tiến độ hiện tại đang được hoàn thiện.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 80px 0 48px;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .page-title {
    font-family: 'Cormorant Garamond', var(--font-serif);
    font-size: 3rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .page-lead {
    max-width: 600px;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .project-card {
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-top: 3px solid var(--color-gold);
  }

  .project-card h2 {
    margin-bottom: 12px;
    font-size: 1.5rem;
  }

  .project-card p {
    font-size: 0.95rem;
  }

  .progress-empty {
    min-height: 180px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
  }

  @media (max-width: 650px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
