---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Layout title="Ủng hộ" description="Tìm hiểu cách sự ủng hộ tự nguyện có thể giúp OAK tiếp tục phát triển.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow fade-in">Ủng hộ</span>
      <h1 class="page-title fade-in fade-in-delay-1">Đồng hành cùng OAK</h1>
      <div class="divider fade-in fade-in-delay-2"></div>
      <p class="page-lead fade-in fade-in-delay-2">
        Sự ủng hộ là tự nguyện và giúp duy trì công việc phát triển thế giới, câu chuyện, hình ảnh và các phần liên quan đến game.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <SectionHeader eyebrow="Ủng hộ tự nguyện" title="Giúp dự án tiếp tục phát triển" subtitle="Bạn không cần đóng góp để khám phá dự án. Các hình thức ủng hộ sẽ chỉ được công bố khi thông tin thanh toán sẵn sàng và đã được xác minh." align="center" />
      <div class="support-panel">
        <div class="qr-placeholder empty-visual" aria-label="MoMo QR code placeholder">
          <span>Mã QR MoMo sẽ được bổ sung</span>
        </div>
        <div class="support-copy">
          <h2>Sự ủng hộ giúp ích cho điều gì?</h2>
          <p>Sự ủng hộ tự nguyện có thể giúp duy trì thời gian dành cho việc viết, phát triển thế giới, hoàn thiện hình ảnh được duyệt và bảo trì dự án.</p>
          <p class="support-note">Thông tin thanh toán chưa được bổ sung.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 80px 0 48px;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .page-title {
    font-family: 'Cormorant Garamond', var(--font-serif);
    font-size: 3rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .page-lead {
    max-width: 640px;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }

  .support-panel {
    display: grid;
    grid-template-columns: minmax(220px, 280px) 1fr;
    gap: 40px;
    align-items: center;
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
  }

  .qr-placeholder {
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
  }

  .support-copy h2 {
    margin-bottom: 12px;
    font-size: 1.6rem;
  }

  .support-copy p {
    margin-bottom: 16px;
  }

  .support-note {
    color: var(--color-ink-muted);
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }

  @media (max-width: 650px) {
    .support-panel {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 24px;
    }

    .qr-placeholder {
      max-width: 240px;
      width: 100%;
      margin: 0 auto;
    }
  }
</style>
